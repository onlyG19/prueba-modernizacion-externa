# ─────────────────────────────────────────────────────────────
# Variables de entorno del Backend, y en sí, de la API
# Para usarlo; copia este archivo a .env y ajusta los valores:  cp .env.example .env
# El .env NO se debería versionar (para ello está en .gitignore); este archivo SÍ.
# ─────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────
PORT=3000
# development | production | test
NODE_ENV=development
# Orígenes permitidos para CORS, separados por comas y sin barra final,
# p. ej.: https://app.ejemplo.cl,http://localhost:5173
# "*" permite cualquier origen y solo se acepta fuera de producción.
CORS_ORIGIN=*

# ── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
# docker-compose expone Postgres en el 5433 del host (no el 5432 por defecto)
DB_PORT=5433
DB_NAME=prueba_modernizacion
# Credenciales de desarrollo local; deben coincidir con docker-compose.yml
DB_USER=postgres
DB_PASSWORD=postgres

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
