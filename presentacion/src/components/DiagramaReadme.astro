---
/**
 * Una diapositiva con un diagrama del README del proyecto (los que pide la
 * prueba en sus puntos 1 y 2), ya convertido a SVG por `pnpm diagramas`.
 * Ocupa toda la diapositiva; un clic (o la tecla Z) lo abre en el visor.
 */
import Diapositiva from './Diapositiva.astro';
import diagramas from '../diagramas/diagramas.json';

interface Props {
  numero: number;
  total: number;
  /** El número del diagrama en el README: "1", "2.1"… */
  diagrama: string;
}

const { numero, total, diagrama } = Astro.props;

const svgs = import.meta.glob<string>('../diagramas/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const datos = diagramas.find((d) => d.numero === diagrama);
const svg = datos && svgs[`../diagramas/${datos.archivo}`];
if (!datos || !svg) {
  throw new Error(`No está el diagrama ${diagrama} del README: corre "pnpm diagramas".`);
}

const punto = diagrama.split('.')[0];
---

<Diapositiva
  numero={numero}
  total={total}
  seccion={`Punto ${punto} de la prueba`}
  titulo={`<span class="diagrama-numero">${datos.numero}</span> ${datos.titulo}`}
  clase="diagrama"
>
  <button
    type="button"
    class="diagrama-lienzo"
    data-ampliar
    data-titulo={`${datos.numero} ${datos.titulo}`}
    aria-label={`Ampliar el diagrama ${datos.numero}: ${datos.titulo}`}
  >
    <Fragment set:html={svg} />
    <span class="pista" aria-hidden="true">Ampliar ⤢</span>
  </button>
</Diapositiva>

<style is:global>
  .diapositiva.diagrama .titulo {
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    max-width: none;
    font-size: 2.6cqw;
  }

  .diagrama-numero {
    padding: 0.2cqw 0.9cqw;
    border-radius: 0.6cqw;
    font-size: 0.8em;
    color: var(--hoja);
    background: var(--marca-morado);
  }

  /* El diagrama llena todo el alto disponible, no se centra en él. */
  .diapositiva.diagrama .cuerpo {
    grid-template-rows: minmax(0, 1fr);
    align-content: stretch;
    padding: 1.4cqw 0 1cqw;
  }

  .diagrama-lienzo {
    position: relative;
    display: grid;
    min-height: 0;
    padding: 1cqw;
    border: 1px solid var(--borde);
    border-radius: 1cqw;
    background: var(--hoja);
    cursor: zoom-in;
    font: inherit;
  }

  .diagrama-lienzo > svg {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .diagrama-lienzo .pista {
    position: absolute;
    right: 1cqw;
    bottom: 0.8cqw;
    padding: 0.3cqw 0.8cqw;
    border-radius: 0.5cqw;
    font-size: 1.1cqw;
    font-weight: 600;
    color: var(--marca-morado);
    background: var(--marca-morado-tenue);
    opacity: 0;
    transition: opacity 0.2s var(--curva);
  }

  .diagrama-lienzo:hover .pista,
  .diagrama-lienzo:focus-visible .pista {
    opacity: 1;
  }

  @media print {
    .diagrama-lienzo .pista {
      display: none;
    }
  }
</style>
